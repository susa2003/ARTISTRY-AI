zer:{name:"AI Drawing Analyzer",desc:"Multi-factor assessment of proportions, line quality, and symmetry."},generator:{name:"AI Reference Generator",desc:"Generate procedural study references across 11 subjects."},progress:{name:"Drawing Progress AI",desc:"Multi-axis skill radar chart and targeted personalized exercises."},pose:{name:"AI Pose & Gesture Coach",desc:"33-point body skeleton, Line of Action curvature, and balance indicator."},handfoot:{name:"AI Hand & Foot Assistant",desc:"21 hand landmarks, palm box, and finger proportion checks."},lighting:{name:"AI Lighting Predictor",desc:"360\xb0 light vector, shadow zones, and graphite hardness guide."},composition:{name:"AI Composition Coach",desc:"Rule of Thirds power points, Golden Spiral, and negative space."},linecleaner:{name:"AI Line Art Cleaner",desc:"Adaptive Otsu binarization and scanner grain despeckle filter."},segmentation:{name:"AI Smart Segmentation",desc:"Saliency foreground separation and feathered alpha masks."},colorrec:{name:"AI Color Recommender",desc:"Harmonic color harmonies and persistent palette extraction."},turnaround:{name:"AI Multi-Angle Creator",desc:"4-view model turnaround sheets with 8 height guide locks."},replay:{name:"Smart Stroke Replay",desc:"Chronological timelapse replay with 0.5x\u20135x speed scrubber."},mistakes:{name:"AI Mistake Detector",desc:"Facial slant, eye level drift, and cranium proportion alerts."},mentor:{name:"AI Art Mentor",desc:"Conversational pedagogical guide with context-aware advice."},vectorizer:{name:"Sketch-to-Vector Converter",desc:"Multi-pass B\xe9zier contour path simplification and SVG export."}},voice:{title:"Voice Drawing Assistant",listening:"Listening... Speak drawing commands",tapToSpeak:"Tap microphone to speak",suggested:"Suggested Commands:",confirmClear:"Confirm: Clear all artwork on canvas?",yesClear:"Yes, Clear",cancel:"Cancel"},status:{offline:"Offline Mode Active (100% On-Device)",cloudReady:"Cloud AI Connected",notConfigured:"Cloud A