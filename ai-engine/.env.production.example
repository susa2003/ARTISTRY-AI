# ARTISTRY AI — Production Python AI Engine Environment Variables Template
# Copy this file to .env.production and provide production secrets.

# ==============================================================================
# 1. SERVER CONFIGURATION
# ==============================================================================
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
LOG_LEVEL=info
WORKERS=4

# Restrict CORS to internal Node.js backend container
CORS_ORIGINS=http://backend:4000,http://localhost:4000

# ==============================================================================
# 2. CLOUD AI PROVIDERS (BACKEND PROXY)
# ==============================================================================
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local Engine Thresholds
CV_MAX_IMAGE_DIMENSION=2048
CV_JPEG_QUALITY=90
MEDIAPIPE_MODEL_COMPLEXITY=2
