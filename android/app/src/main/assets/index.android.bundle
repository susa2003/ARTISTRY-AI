__d(function(g,r,i,a,m,e,d){"use strict";function t(t){var n=t.replace(/"/g,"'").replace(/[\r\n\t]/g," ");return`data:image/svg+xml;utf8,${encodeURIComponent(n)}`}Object.defineProperty(e,'__esModule',{value:!0}),Object.defineProperty(e,"REFERENCE_LIBRARY",{enumerable:!0,get:function(){return n}}),e.getReferenceImageUri=function(t,n=!1){return n?t.fallbackSvgUri:t.uri||t.fallbackSvgUri};var n=[{id:"ref-portrait-01",title:"Classical Roman Bust (Three-Quarter)",category:"portraits",difficulty:"beginner",description:"Clear planar lighting and distinct 3/4 turn. Ideal for Andrew Loomis 8-stage cranium construction.",suggestedTools:["loomis","shading","grid"],aspectRatio:.75,uri:"https://images.unsplash.com/photo-1544717305-2782549b5136?w=800&q=80",fallbackSvgUri:t("\n      <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 600 800\" width=\"600\" height=\"800\">\n        <rect width=\"600\" height=\"800\" fill=\"#F8F6F0\"/>\n        \x3c!-- Cranium Sphere --\x3e\n        <circle cx=\"320\" cy=\"280\" r=\"140\" fill=\"#EAE5D8\" stroke=\"#28594B\" stroke-width=\"4\"/>\n        \x3c!-- Side Plane Disc --\x3e\n        <ellipse cx=\"380\" cy=\"280\" rx=\"45\" ry=\"95\" fill=\"#E0D9C8\" stroke=\"#28594B\" stroke-width=\"3\" stroke-dasharray=\"6,4\"/>\n        \x3c!-- Brow Line & Axis --\x3e\n        <path d=\"M 200 280 Q 300 295 420 270\" stroke=\"#CB7857\" stroke-width=\"4\" fill=\"none\"/>\n        \x3c!-- Vertical Centerline --\x3e\n        <path d=\"M 280 180 Q 295 300 270 460\" stroke=\"#CB7857\" stroke-width=\"4\" fill=\"none\"/>\n        \x3c!-- Jaw & Chin Wedge --\x3e\n        <path d=\"M 200 310 L 250 480 L 320 480 L 390 340\" stroke=\"#28594B\" stroke-width=\"4\" fill=\"none\"/>\n        \x3c!-- Facial Thirds --\x3e\n        <line x1=\"210\" y1=\"350\" x2=\"360\" y2=\"340\" stroke=\"#9E9581\" stroke-width=\"2\" stroke-dasharray=\"4,4\"/>\n        <line x1=\"230\" y1=\"410\" x2=\"340\" y2=\"405\" stroke=\"#9E9581\" stroke-width=\"2\" stroke-dasharray=\"4,4\"/>\n        \x3c!-- Neck & Torso Pedestal --\x3e\n        <path d=\"M 270 480 L 260 580 L 180 660 L 440 660 L 360 580 L 340 480\" stroke=\"#28594B\" stroke-width=\"3\" fill=\"#EAE5D8\"/>\n        \x3c!-- Study Annotation --\x3e\n        <text x=\"300\" y=\"740\" font-family=\"sans-serif\" font-size=\"20\" font-weight=\"bold\" fill=\"#28594B\" text-anchor=\"middle\">CLASSICAL BUST \xb7 THREE-QUARTER STUDY</text>\n      </svg>\n    "),tags:["sculpture","bust","three-quarter","classical"]},{id:"ref-portrait-02",title:"Side Profile with Dramatic Rim Light",category:"portraits",difficulty:"intermediate",description:"High-contrast side profile with clear nasal bridge keystone and ear placement.",suggestedTools:["loomis","tracing","shading"],aspectRatio:.8,uri:"https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=800&q=80",fallbackSvgUri:t("\n      <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 600 750\" width=\"600\" height=\"750\">\n        <rect width=\"600\" height=\"750\" fill=\"#1C211D\"/>\n        \x3c!-- Profile Silhouette in Rim Light --\x3e\n        <path d=\"M 320 160 C 220 160 170 230 170 310 C 170 330 175 345 185 355 L 170 380 L 210 385 C 200 405 190 415 195 430 L 225 435 C 215 455 205 470 230 485 L 260 485 C 290 530 330 570 330 630 L 420 630 C 420 540 440 470 440 310 C 440 210 390 160 320 160 Z\" fill=\"#28322B\" stroke=\"#D5A844\" stroke-width=\"3\"/>\n        \x3c!-- Ear placement marker --\x3e\n        <ellipse cx=\"330\" cy=\"370\" rx=\"20\" ry=\"32\" fill=\"none\" stroke=\"#CB7857\" stroke-width=\"3\"/>\n        <text x=\"300\" y=\"700\" font-family=\"sans-serif\" font-size=\"18\" font-weight=\"bold\" fill=\"#D5A844\" text-anchor=\"middle\">SIDE PROFILE \xb7 RIM LIGHT SILHOUETTE</text>\n      </svg>\n    "),tags:["profile","rim-light","silhouette"]},{id:"ref-anatomy-01",title:"Classical Torso & Contrapposto Pose",category:"anatomy",difficulty:"intermediate",description:"Canonical contrapposto with tilted pelvic basin and opposing shoulder line.",suggestedTools:["grid","tracing","shading"],aspectRatio:.7,uri:"https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?w=800&q=80",fallbackSvgUri:t("\n      <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 600 850\" width=\"600\" height=\"850\">\n        <rect width=\"600\" height=\"850\" fill=\"#F8F6F0\"/>\n        \x3c!-- Spine of action --\x3e\n        <path d=\"M 300 120 Q 320 300 285 450 Q 270 560 290 750\" stroke=\"#CB7857\" stroke-width=\"4\" stroke-dasharray=\"6,4\" fill=\"none\"/>\n        \x3c!-- Opposing Shoulder Tilt --\x3e\n        <line x1=\"160\" y1=\"230\" x2=\"440\" y2=\"200\" stroke=\"#28594B\" stroke-width=\"5\"/>\n        \x3c!-- Opposing Pelvic Tilt (Contrapposto) --\x3e\n        <line x1=\"190\" y1=\"460\" x2=\"410\" y2=\"495\" stroke=\"#28594B\" stroke-width=\"5\"/>\n        \x3c!-- Thoracic Ribcage --\x3e\n        <ellipse cx=\"305\" cy=\"310\" rx=\"95\" ry=\"110\" fill=\"#EAE5D8\" stroke=\"#28594B\" stroke-width=\"3\"/>\n        \x3c!-- Pelvic Bucket --\x3e\n        <polygon points=\"210,470 390,490 360,570 240,560\" fill=\"#E0D9C8\" stroke=\"#28594B\" stroke-width=\"3\"/>\n        <text x=\"300\" y=\"800\" font-family=\"sans-serif\" font-size=\"18\" font-weight=\"bold\" fill=\"#28594B\" text-anchor=\"middle\">CONTRAPPOSTO CANON \xb7 OPPOSING AXES</text>\n      </svg>\n    "),tags:["contrapposto","torso","figure","musculature"]},{id:"ref-anatomy-02",title:"Hand Study in Dynamic Grip",category:"anatomy",difficulty:"advanced",description:"Foreshortened fingers and palm planes. Excellent for testing line confidence.",suggestedTools:["grid","tracing"],aspectRatio:.85,uri:"https://images.unsplash.com/photo-1582562124811-c09040d0a901?w=800&q=80",fallbackSvgUri:t("\n      <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 600 700\" width=\"600\" height=\"700\">\n        <rect width=\"600\" height=\"700\" fill=\"#F8F6F0\"/>\n        \x3c!-- Palm Wedge --\x3e\n        <polygon points=\"220,380 380,360 410,500 240,510\" fill=\"#EAE5D8\" stroke=\"#28594B\" stroke-width=\"4\"/>\n        \x3c!-- Thumb Column --\x3e\n        <path d=\"M 230 400 L 160 380 L 140 320 L 180 300 L 240 350\" fill=\"#E0D9C8\" stroke=\"#28594B\" stroke-width=\"3\"/>\n        \x3c!-- 4 Finger Arcs --\x3e\n        <path d=\"M 250 370 L 260 240 L 280 235 L 285 365\" fill=\"#E0D9C8\" stroke=\"#28594B\" stroke-width=\"3\"/>\n        <path d=\"M 290 365 L 305 210 L 330 205 L 330 362\" fill=\"#E0D9C8\" stroke=\"#28594B\" stroke-width=\"3\"/>\n        <path d=\"M 335 362 L 350 230 L 370 230 L 368 360\" fill=\"#E0D9C8\" stroke=\"#28594B\" stroke-width=\"3\"/>\n        <path d=\"M 372 360 L 390 270 L 405 275 L 398 362\" fill=\"#E0D9C8\" stroke=\"#28594B\" stroke-width=\"3\"/>\n        <text x=\"300\" y=\"650\" font-family=\"sans-serif\" font-size=\"18\" font-weight=\"bold\" fill=\"#28594B\" text-anchor=\"middle\">HAND ANATOMY \xb7 PALM PLANES & ARCS</text>\n      </svg>\n    "),tags:["hands","foreshortening","gesture"]},{id:"ref-animal-01",title:"Arabian Stallion Head in Profile",category:"animals",difficulty:"beginner",description:"Geometric muzzle block, large cranial sphere, and arched cervical vertebrae.",suggestedTools:["grid","tracing"],aspectRatio:.75,uri:"https://images.unsplash.com/photo-1553284965-83fd3e82fa5a?w=800&q=80",fallbackSvgUri:t("\n      <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 600 800\" width=\"600\" height=\"800\">\n        <rect width=\"600\" height=\"800\" fill=\"#F8F6F0\"/>\n        \x3c!-- Cranial Sphere --\x3e\n        <circle cx=\"360\" cy=\"270\" r=\"110\" fill=\"#EAE5D8\" stroke=\"#28594B\" stroke-width=\"4\"/>\n        \x3c!-- Muzzle Box --\x3e\n        <polygon points=\"310,320 200,430 160,420 180,380 280,260\" fill=\"#E0D9C8\" stroke=\"#28594B\" stroke-width=\"4\"/>\n        \x3c!-- Arched Neck Column --\x3e\n        <path d=\"M 420 190 Q 520 280 500 550\" stroke=\"#CB7857\" stroke-width=\"5\" fill=\"none\"/>\n        <path d=\"M 330 380 Q 360 480 340 560\" stroke=\"#28594B\" stroke-width=\"4\" fill=\"none\"/>\n        <text x=\"300\" y=\"720\" font-family=\"sans-serif\" font-size=\"18\" font-weight=\"bold\" fill=\"#28594B\" text-anchor=\"middle\">EQUINE ANATOMY \xb7 CRANIUM & MUZZLE WEDGE</text>\n      </svg>\n    "),tags:["horse","wildlife","profile"]},{id:"ref-animal-02",title:"Bengal Tiger Gaze",category:"animals",difficulty:"intermediate",description:"Symmetrical feline facial planes with striking stripe patterns for grid mapping.",suggestedTools:["grid","shading"],aspectRatio:.8,uri:"https://images.unsplash.com/photo-1561731216-c3a4d99437d5?w=800&q=80",fallbackSvgUri:t("\n      <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 600 750\" width=\"600\" height=\"750\">\n        <rect width=\"600\" height=\"750\" fill=\"#F8F6F0\"/>\n        \x3c!-- Symmetrical Feline Mask --\x3e\n        <polygon points=\"300,160 440,240 460,430 380,540 300,560 220,540 140,430 160,240\" fill=\"#EAE5D8\" stroke=\"#28594B\" stroke-width=\"4\"/>\n        \x3c!-- Muzzle Diamond --\x3e\n        <polygon points=\"300,340 350,440 300,500 250,440\" fill=\"#E0D9C8\" stroke=\"#CB7857\" stroke-width=\"3\"/>\n        \x3c!-- Eyes --\x3e\n        <ellipse cx=\"230\" cy=\"330\" rx=\"24\" ry=\"16\" fill=\"#D5A844\" stroke=\"#1C211D\" stroke-width=\"3\"/>\n        <ellipse cx=\"370\" cy=\"330\" rx=\"24\" ry=\"16\" fill=\"#D5A844\" stroke=\"#1C211D\" stroke-width=\"3\"/>\n        <text x=\"300\" y=\"680\" font-family=\"sans-serif\" font-size=\"18\" font-weight=\"bold\" fill=\"#28594B\" text-anchor=\"middle\">FELINE HEAD PLANES \xb7 SYMMETRIC MASK</text>\n      </svg>\n    "),tags:["tiger","feline","symmetry"]},{id:"ref-landscape-01",title:"Venetian Canal in One-Point Perspective",category:"landscapes",difficulty:"intermediate",description:"Direct central vanishing point with converging architectural facades and reflections.",suggestedTools:["grid","tracing"],aspectRatio:.75,uri:"https://images.unsplash.com/photo-1523906834658-6e2b32c840bf?w=800&q=80",fallbackSvgUri:t("\n      <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 600 800\" width=\"600\" height=\"800\">\n        <rect width=\"600\" height=\"800\" fill=\"#F8F6F0\"/>\n        \x3c!-- Central Horizon & VP --\x3e\n        <line x1=\"0\" y1=\"360\" x2=\"600\" y2=\"360\" stroke=\"#CB7857\" stroke-width=\"3\"/>\n        <circle cx=\"300\" cy=\"360\" r=\"8\" fill=\"#CB7857\"/>\n        \x3c!-- Converging Facade Orthogonals --\x3e\n        <line x1=\"300\" y1=\"360\" x2=\"0\" y2=\"100\" stroke=\"#28594B\" stroke-width=\"3\"/>\n        <line x1=\"300\" y1=\"360\" x2=\"600\" y2=\"100\" stroke=\"#28594B\" stroke-width=\"3\"/>\n        \x3c!-- Canal Waterline --\x3e\n        <line x1=\"300\" y1=\"360\" x2=\"140\" y2=\"800\" stroke=\"#596A94\" stroke-width=\"4\"/>\n        <line x1=\"300\" y1=\"360\" x2=\"460\" y2=\"800\" stroke=\"#596A94\" stroke-width=\"4\"/>\n        <text x=\"300\" y=\"740\" font-family=\"sans-serif\" font-size=\"18\" font-weight=\"bold\" fill=\"#28594B\" text-anchor=\"middle\">ONE-POINT PERSPECTIVE \xb7 CANAL CONVERGENCE</text>\n      </svg>\n    "),tags:["venice","perspective","architecture","canal"]},{id:"ref-master-01",title:"Leonardo Da Vinci Drapery Study",category:"master_studies",difficulty:"advanced",description:"Classical chiaroscuro with cast shadows, pipe folds, and diaper folds.",suggestedTools:["shading","tracing"],aspectRatio:.7,uri:"https://images.unsplash.com/photo-1579783902614-a3fb3927b675?w=800&q=80",fallbackSvgUri:t("\n      <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 600 850\" width=\"600\" height=\"850\">\n        <rect width=\"600\" height=\"850\" fill=\"#EDE7DC\"/>\n        \x3c!-- Pipe Folds & Chiaroscuro Masses --\x3e\n        <path d=\"M 200 180 C 220 340 180 520 160 720 L 260 740 C 270 540 280 360 260 180 Z\" fill=\"#D3C9B8\" stroke=\"#4A3F35\" stroke-width=\"3\"/>\n        <path d=\"M 280 180 C 310 350 300 540 290 730 L 380 740 C 380 540 370 340 340 180 Z\" fill=\"#BDB09D\" stroke=\"#4A3F35\" stroke-width=\"3\"/>\n        <path d=\"M 370 200 C 430 380 440 560 450 720 L 510 700 C 490 530 470 350 430 200 Z\" fill=\"#998A78\" stroke=\"#4A3F35\" stroke-width=\"3\"/>\n        <text x=\"300\" y=\"800\" font-family=\"sans-serif\" font-size=\"18\" font-weight=\"bold\" fill=\"#4A3F35\" text-anchor=\"middle\">LEONARDO DRAPERY \xb7 5-VALUE CHIAROSCURO</text>\n      </svg>\n    "),tags:["drapery","chiaroscuro","renaissance"]}]},2270,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,'__esModule',{value:!0}),Object.defineProperty(e,"ART_LESSONS",{enumerable:!0,get:function(){return t}}),Object.defineProperty(e,"DAILY_CHALLENGES",{enumerable:!0,get:function(){return n}}),e.getTodayChallenge=function(){var t=(new Date).toISOString().split("T")[0],o=(new Date).getDay(),s=n[o%n.length];return{date:t,...s}};var t=[{id:"lesson-01",number:1,title:"Line Confidence & Ghosting",category:"fundamentals",estimatedMinutes:15,objective:"Draw clean, deliberate, unhesitant lines from the shoulder instead of the wrist.",principles:["Ghost the stroke: trace the motion in the air above the screen 2\u20133 times before contacting.","Draw with shoulder and elbow joints to maintain straight trajectory.","Avoid 'hairy' scratchy lines; commit to single continuous strokes."],exercises:["Place two dots across the canvas and connect them with one swift stroke.","Draw 10 parallel diagonal hatching lines maintaining uniform 3mm spacing."]},{id:"lesson-02",number:2,title:"The Andrew Loomis Cranium Method",category:"loomis",estimatedMinutes:25,objective:"Construct the head in 3D space using the ball-and-plane method.",principles:["The cranial sphere represents the permanent solid mass of the skull.","The brow line acts as the equator; tilt dictates pitch.","The side plane is cut flat by an ellipse that measures 2/3 the total height."],exercises:["Draw 5 cranium spheres from different yaw and pitch angles.","Add the brow line, centerline, and side plane disc to each."]},{id:"lesson-03",number:3,title:"The 8-Head Human Proportion Cannon",category:"anatomy",estimatedMinutes:20,objective:"Master canonical body divisions for accurate standing figures.",principles:["The height of the head is the fundamental measuring unit.","The groin/pubic arch divides the body exactly into two equal halves (4 heads each).","Shoulder width equals 2 full head heights; pelvic width equals 1.5 head heights."],exercises:["Mark 8 equal vertical divisions on a blank canvas.","Block in head, ribcage, pelvis, and leg joints conforming to the landmarks."]},{id:"lesson-04",number:4,title:"The 5-Value Form Shading Scale",category:"shading",estimatedMinutes:20,objective:"Organize lighting into five distinct, non-overlapping tonal masses.",principles:["Never blend light values into shadow values; keep the terminator crisp.","Reflected light is always darker than the darkest light value.","Group shadows together first before modeling halftones."],exercises:["Shade a sphere using all 5 distinct tonal steps without gradient blurring."]},{id:"lesson-05",number:5,title:"Two-Point Perspective for Objects & Architecture",category:"perspective",estimatedMinutes:25,objective:"Construct boxes and forms in two-point perspective using vanishing points.",principles:["All horizontal edges converge towards either the Left or Right Vanishing Point.","All vertical edges remain parallel to each other and perpendicular to the horizon.","The horizon line strictly represents the artist's eye level."],exercises:["Set two vanishing points on the horizon line and draw three stacked boxes."]},{id:"lesson-06",number:6,title:"Sight-Size Comparison & Contour Verification",category:"fundamentals",estimatedMinutes:20,objective:"Verify drawing accuracy using horizontal and vertical plumb lines against a reference.",principles:["Use plumb lines to check vertical alignment between key landmarks (e.g. tear duct to nostril wing).","Check negative space silhouettes to catch contour deviations before detailing.","Compare drawing in 50/50 split mode to instantly detect proportional drift."],exercises:["Use Reference vs My Drawing split-screen to overlay your sketch over a classical portrait reference.","Inspect the line-accuracy heatmap and correct any red deviating contours."]}],n=[{dayOfWeek:0,title:"Sunday Classical Bust Study",theme:"Loomis Construction",timeLimitMinutes:20,prompt:"Construct a 3/4 turn head study focusing strictly on the cranial sphere and facial thirds.",rubric:["Cranium proportion","Brow tilt accuracy","Facial thirds division"]},{dayOfWeek:1,title:"Monday Gesture Sprint",theme:"Line Confidence",timeLimitMinutes:10,prompt:"Execute 10 swift, single-stroke gesture sketches capturing dynamic silhouette movement.",rubric:["No scratchy lines","Clear line of action","Fluid rhythm"]},{dayOfWeek:2,title:"Tuesday 5-Value Sphere Study",theme:"Form Shading",timeLimitMinutes:15,prompt:"Render a geometric sphere showing Highlight, Halftone, Core Shadow, Reflected Light, and Cast Shadow.",rubric:["Crisp terminator","Dark reflected light","Definite cast shadow"]},{dayOfWeek:3,title:"Wednesday Perspective City Block",theme:"2-Point Perspective",timeLimitMinutes:20,prompt:"Draw three building blocks on a corner using 2 vanishing points with window grid guides.",rubric:["True vertical lines","Clean convergence to VPs","Consistent horizon"]},{dayOfWeek:4,title:"Thursday Anatomical Hand Grip",theme:"Anatomy",timeLimitMinutes:15,prompt:"Study your non-drawing hand holding a cylindrical object. Block in the palm plane first.",rubric:["Palm box proportion","Knuckle arch alignment","Foreshortened fingers"]},{dayOfWeek:5,title:"Friday High-Contrast Silhouette",theme:"Tracing & Contour",timeLimitMinutes:10,prompt:"Practice high-contrast tracing of a profile reference, focusing on negative space shapes.",rubric:["Accurate negative spaces","Confident outer contour","Feature placement"]},{dayOfWeek:6,title:"Saturday Master Study Reproduction",theme:"Master Studies",timeLimitMinutes:25,prompt:"Reproduce the facial structure of a Renaissance sculpture using the Smart Grid for proportion.",rubric:["Proportional grid accuracy","Value harmony","Refined contour"]}]},2271,[]);
