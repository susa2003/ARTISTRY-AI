# ARTISTRY AI — Production Backend Environment Variables Template
# Copy this file to .env.production and provide production secrets.

# ==============================================================================
# 1. CORE SERVER CONFIGURATION
# ==============================================================================
PORT=4000
NODE_ENV=production
API_PREFIX=/api/v1

# In production, restrict CORS origins to your verified mobile app scheme and web/admin domain(s).
# Multiple origins can be comma-separated.
CORS_ORIGIN=https://admin.artistry.ai,https://api.artistry.ai

# Python FastAPI AI Engine Bridge (internal Docker/K8s service name or private IP)
FASTAPI_AI_URL=http://ai-engine:8000

# ==============================================================================
# 2. DATABASE (MONGODB) CONFIGURATION
# ==============================================================================
ENABLE_MONGODB=true
# Use authenticated MongoDB connection string with TLS and replica set enabled:
MONGODB_URI=mongodb://artistry_app_user:REPLACE_WITH_STRONG_DB_PASSWORD@mongodb:27017/artistry_ai?authSource=admin&replicaSet=rs0

# ==============================================================================
# 3. AUTHENTICATION & SECURITY SECRETS
# ==============================================================================
# MANDATORY: Generate a high-entropy secret (e.g., `openssl rand -base64 48`)
JWT_SECRET=REPLACE_WITH_HIGH_ENTROPY_64_CHAR_PRODUCTION_SECRET
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_DAYS=60

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==============================================================================
# 4. STORAGE & FILE HANDLING
# ==============================================================================
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=25

# ==============================================================================
# 5. GOOGLE PLAY BILLING SERVICE CREDENTIALS
# ==============================================================================
# Base64-encoded Google Play Developer Service Account JSON key or absolute path
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=
GOOGLE_PLAY_PACKAGE_NAME=ai.artistry.studio

# ==============================================================================
# 6. EXTERNAL CLOUD AI PROVIDERS (SERVER-SIDE SECRETS)
# ==============================================================================
# Never expose these keys to the Android client! All AI requests are proxied securely.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
