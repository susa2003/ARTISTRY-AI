# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*

# Python FastAPI AI Engine Bridge
FASTAPI_AI_URL=http://localhost:8000

# MongoDB Configuration (Optional for offline/local development)
MONGODB_URI=mongodb://localhost:27017/artistry_ai
ENABLE_MONGODB=false

# Authentication Secrets
JWT_SECRET=artistry_ai_super_secure_jwt_secret_dev_only_change_in_production
JWT_EXPIRES_IN=7d

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# External Provider API Keys (Managed server-side, never exposed to client)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
