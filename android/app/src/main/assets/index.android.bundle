center",gap:10,marginTop:6},heroBtn:{backgroundColor:"#28594B",paddingHorizontal:16,paddingVertical:12,borderRadius:12},heroBtnText:{fontSize:13,fontWeight:"700",color:"#FFFFFF"},guideBtn:{backgroundColor:"#232F28",paddingHorizontal:14,paddingVertical:12,borderRadius:12,borderWidth:1,borderColor:"#304037"},guideBtnText:{fontSize:13,fontWeight:"600",color:"#DCE5DF"},progressCard:{backgroundColor:"#19201C",borderRadius:18,padding:18,borderWidth:1,borderColor:"#26322B",gap:12},progressHeader:{flexDirection:"row",justifyContent:"space-between",alignItems:"center"},progressCardTitle:{fontSize:16,fontWeight:"700",color:"#F6F5EE"},progressCardSub:{fontSize:12,color:"#8B9A90",marginTop:2},percentBadge:{backgroundColor:"#203027",paddingHorizontal:10,paddingVertical:4,borderRadius:8,borderWidth:1,borderColor:"#2F473A"},percentText:{fontSize:14,fontWeight:"800",color:"#6CD498"},progressBarTrack:{height:8,borderRadius:4,backgroundColor:"#232D27",overflow:"hidden"},progressBarFill:{height:8,borderRadius:4,backgroundColor:"#4EA87D"},statsRow:{flexDirection:"row",justifyContent:"space-around",alignItems:"center",paddingTop:8,borderTopWidth:1,borderTopColor:"#242E28"},statBox:{alignItems:"center"},statValue:{fontSize:16,fontWeight:"800",color:"#F6F5EE"},statLabel:{fontSize:11,color:"#809085",marginTop:2},statDivider:{width:1,height:24,backgroundColor:"#26322B"},sectionHeaderRow:{flexDirection:"row",justifyContent:"space-between",alignItems:"flex-end",marginTop:6},sectionMainTitle:{fontSize:18,fontWeight:"800",color:"#F6F5EE"},sectionMainSub:{fontSize:12,color:"#8B9A90",marginTop:2},newDrawingBtn:{backgroundColor:"#202C25",paddingHorizontal:10,paddingVertical:6,borderRadius:8,borderWidth:1,borderColor:"#2E4237"},newDrawingBtnText:{fontSize:12,fontWeight:"700",color:"#5EB689"},newRefBtn:{backgroundColor:"#242A27",borderColor:"#33453B"},newRefBtnText:{color:"#92B8A4"},levelCard:{backgroundColor:"#18201C",borderRadius:16,borderWidth:1,borderColor:"#28342D",overflow:"hidden"},levelHeade